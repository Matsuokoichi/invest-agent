{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.fulcrum.local/investment-research-report-v1.json",
  "title": "Investment Research Report V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_id",
    "status",
    "generated_at",
    "as_of_date",
    "company",
    "market",
    "scope",
    "recommendation",
    "summary",
    "business",
    "industry_competition",
    "financial_analysis",
    "future_drivers",
    "management",
    "valuation",
    "market_expectations",
    "counter_thesis",
    "scenarios",
    "catalysts",
    "risks",
    "conclusion",
    "claims",
    "sources",
    "audit"
  ],
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "COMPLETE" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "recommendation": {
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "enum": ["BUY", "WATCH", "AVOID"]
              }
            }
          },
          "audit": {
            "type": "object",
            "properties": {
              "latest_filings_checked": { "const": true },
              "point_in_time_checked": { "const": true },
              "citations_checked": { "const": true },
              "calculations_checked": { "const": true },
              "counter_thesis_checked": { "const": true },
              "schema_checked": { "const": true },
              "critical_gaps": { "type": "array", "maxItems": 0 }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": { "const": "INCOMPLETE" }
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "recommendation": {
            "type": "object",
            "properties": {
              "action": { "type": "string", "const": "WATCH" }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": { "const": "UNSUPPORTED" }
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "recommendation": {
            "type": "object",
            "properties": {
              "action": { "type": "string", "const": "NO_RATING" }
            }
          }
        }
      }
    }
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "report_id": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "enum": ["COMPLETE", "INCOMPLETE", "UNSUPPORTED"]
    },
    "generated_at": { "type": "string", "format": "date-time" },
    "as_of_date": { "type": "string", "format": "date" },
    "company": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ticker", "name", "exchange", "security_type"],
      "properties": {
        "ticker": { "type": "string", "pattern": "^[A-Z.]{1,10}$" },
        "name": { "type": "string", "minLength": 1 },
        "cik": { "type": ["string", "null"], "pattern": "^[0-9]{10}$" },
        "exchange": { "type": "string", "enum": ["NYSE", "NASDAQ"] },
        "security_type": { "type": "string", "enum": ["COMMON_STOCK", "ADR"] },
        "sector": { "type": ["string", "null"] },
        "industry": { "type": ["string", "null"] }
      }
    },
    "market": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current_price",
        "currency",
        "price_timestamp",
        "treasury_yield",
        "treasury_maturity_months"
      ],
      "properties": {
        "current_price": { "type": "number", "exclusiveMinimum": 0 },
        "currency": { "const": "USD" },
        "price_timestamp": { "type": "string", "format": "date-time" },
        "treasury_yield": { "type": "number", "minimum": -0.1, "maximum": 1 },
        "treasury_maturity_months": {
          "type": "integer",
          "enum": [12, 24, 36]
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["investment_horizon_months", "explicit_forecast_years"],
      "properties": {
        "investment_horizon_months": {
          "type": "integer",
          "minimum": 12,
          "maximum": 36
        },
        "explicit_forecast_years": {
          "type": "integer",
          "minimum": 5,
          "maximum": 10
        }
      }
    },
    "recommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "business_quality",
        "investment_attractiveness",
        "confidence",
        "intrinsic_value_as_of_range",
        "horizon_target_range",
        "base_case_total_return",
        "expected_total_return",
        "expected_annualized_return",
        "risk_premium",
        "margin_of_safety",
        "decision_hurdle",
        "rationale"
      ],
      "properties": {
        "action": {
          "type": "string",
          "enum": ["BUY", "WATCH", "AVOID", "NO_RATING"]
        },
        "business_quality": {
          "type": "string",
          "enum": ["Strong", "Moderate", "Weak", "Unknown"]
        },
        "investment_attractiveness": {
          "type": "string",
          "enum": ["Attractive", "Watchlist", "Unattractive", "Undetermined"]
        },
        "confidence": {
          "type": "string",
          "enum": ["High", "Medium", "Low"]
        },
        "intrinsic_value_as_of_range": {
          "type": "object",
          "additionalProperties": false,
          "required": ["bear", "base", "bull", "currency"],
          "properties": {
            "bear": { "type": "number", "minimum": 0 },
            "base": { "type": "number", "minimum": 0 },
            "bull": { "type": "number", "minimum": 0 },
            "currency": { "const": "USD" }
          }
        },
        "horizon_target_range": {
          "type": "object",
          "additionalProperties": false,
          "required": ["bear", "base", "bull", "currency"],
          "properties": {
            "bear": { "type": "number", "minimum": 0 },
            "base": { "type": "number", "minimum": 0 },
            "bull": { "type": "number", "minimum": 0 },
            "currency": { "const": "USD" }
          }
        },
        "base_case_total_return": { "type": ["number", "null"], "minimum": -1 },
        "expected_total_return": { "type": ["number", "null"], "minimum": -1 },
        "expected_annualized_return": { "type": ["number", "null"], "minimum": -1 },
        "risk_premium": { "type": ["number", "null"], "minimum": -1 },
        "margin_of_safety": { "type": ["number", "null"], "maximum": 1 },
        "decision_hurdle": { "type": "number", "minimum": 0, "maximum": 1 },
        "rationale": { "type": "string", "minLength": 1 }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["core_thesis", "why_now", "primary_risk"],
      "properties": {
        "core_thesis": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": { "type": "string", "minLength": 1 }
        },
        "why_now": { "type": "string", "minLength": 1 },
        "primary_risk": { "type": "string", "minLength": 1 }
      }
    },
    "business": { "$ref": "#/$defs/analysisSection" },
    "industry_competition": {
      "allOf": [
        { "$ref": "#/$defs/analysisSection" },
        {
          "type": "object",
          "required": ["competitive_advantage"],
          "properties": {
            "competitive_advantage": {
              "type": "string",
              "enum": ["Strong", "Moderate", "Weak", "Unknown"]
            }
          }
        }
      ]
    },
    "financial_analysis": {
      "allOf": [
        { "$ref": "#/$defs/analysisSection" },
        {
          "type": "object",
          "required": ["historical_years", "metric_definitions"],
          "properties": {
            "historical_years": { "type": "integer", "minimum": 5 },
            "metric_definitions": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            }
          }
        }
      ]
    },
    "future_drivers": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "items": { "$ref": "#/$defs/futureDriver" }
    },
    "management": { "$ref": "#/$defs/analysisSection" },
    "valuation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["methods", "model_reconciliation"],
      "properties": {
        "methods": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/valuationMethod" }
        },
        "model_reconciliation": { "type": "string", "minLength": 1 }
      }
    },
    "market_expectations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "priced_in",
        "our_view",
        "difference",
        "supporting_claim_ids",
        "why_market_may_be_wrong"
      ],
      "properties": {
        "priced_in": { "type": "string", "minLength": 1 },
        "our_view": { "type": "string", "minLength": 1 },
        "difference": { "type": "string", "minLength": 1 },
        "supporting_claim_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "why_market_may_be_wrong": { "type": "string", "minLength": 1 }
      }
    },
    "counter_thesis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strongest_counter_evidence",
        "source_claim_ids",
        "reconsideration"
      ],
      "properties": {
        "strongest_counter_evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "source_claim_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "reconsideration": { "type": "string", "minLength": 1 }
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/scenario" }
    },
    "catalysts": {
      "type": "array",
      "items": { "$ref": "#/$defs/catalyst" }
    },
    "risks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/risk" }
    },
    "conclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason",
        "unresolved_questions",
        "next_checks",
        "upgrade_conditions",
        "downgrade_conditions"
      ],
      "properties": {
        "reason": { "type": "string", "minLength": 1 },
        "unresolved_questions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "next_checks": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "upgrade_conditions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "downgrade_conditions": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/claim" }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/source" }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "latest_filings_checked",
        "point_in_time_checked",
        "citations_checked",
        "calculations_checked",
        "counter_thesis_checked",
        "schema_checked",
        "critical_gaps"
      ],
      "properties": {
        "latest_filings_checked": { "type": "boolean" },
        "point_in_time_checked": { "type": "boolean" },
        "citations_checked": { "type": "boolean" },
        "calculations_checked": { "type": "boolean" },
        "counter_thesis_checked": { "type": "boolean" },
        "schema_checked": { "type": "boolean" },
        "critical_gaps": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "analysisSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "claim_ids"],
      "properties": {
        "summary": { "type": "string", "minLength": 1 },
        "claim_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "competitive_advantage": {
          "type": "string",
          "enum": ["Strong", "Moderate", "Weak", "Unknown"]
        },
        "historical_years": { "type": "integer", "minimum": 5 },
        "metric_definitions": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "futureDriver": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "claim",
        "economic_mechanism",
        "financial_impact",
        "valuation_impact",
        "evidence_claim_ids"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "claim": { "type": "string", "minLength": 1 },
        "economic_mechanism": { "type": "string", "minLength": 1 },
        "financial_impact": { "type": "string", "minLength": 1 },
        "valuation_impact": { "type": "string", "minLength": 1 },
        "evidence_claim_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        }
      }
    },
    "valuationMethod": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "applicable", "result", "key_assumptions", "sensitivity"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["DCF", "RELATIVE", "REVERSE_DCF", "OTHER"]
        },
        "applicable": { "type": "boolean" },
        "result": { "type": "string", "minLength": 1 },
        "key_assumptions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "sensitivity": { "type": "string", "minLength": 1 }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "probability",
        "intrinsic_value_as_of",
        "target_value_at_horizon",
        "cumulative_dividends",
        "total_return",
        "annualized_return",
        "driver_assumptions"
      ],
      "properties": {
        "name": { "type": "string", "enum": ["Bear", "Base", "Bull"] },
        "probability": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1,
          "multipleOf": 0.05
        },
        "intrinsic_value_as_of": { "type": "number", "minimum": 0 },
        "target_value_at_horizon": { "type": "number", "minimum": 0 },
        "cumulative_dividends": { "type": "number", "minimum": 0 },
        "total_return": { "type": "number", "minimum": -1 },
        "annualized_return": { "type": "number", "minimum": -1 },
        "driver_assumptions": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        }
      }
    },
    "catalyst": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "timeframe", "expected_effect"],
      "properties": {
        "description": { "type": "string", "minLength": 1 },
        "timeframe": { "type": "string", "minLength": 1 },
        "expected_effect": { "type": "string", "minLength": 1 }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description",
        "probability",
        "impact",
        "evidence_claim_ids",
        "leading_indicators",
        "thesis_implication",
        "invalidation_condition"
      ],
      "properties": {
        "description": { "type": "string", "minLength": 1 },
        "probability": { "type": "string", "enum": ["High", "Medium", "Low"] },
        "impact": { "type": "string", "enum": ["High", "Medium", "Low"] },
        "evidence_claim_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "leading_indicators": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "thesis_implication": { "type": "string", "minLength": 1 },
        "invalidation_condition": { "type": "string", "minLength": 1 }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "text", "material", "source_ids", "reasoning"],
      "properties": {
        "id": { "type": "string", "pattern": "^C[0-9]+$" },
        "type": { "type": "string", "enum": ["FACT", "ESTIMATE", "INFERENCE"] },
        "text": { "type": "string", "minLength": 1 },
        "material": { "type": "boolean" },
        "source_ids": {
          "type": "array",
          "items": { "type": "string", "pattern": "^S[0-9]+$" }
        },
        "reasoning": { "type": ["string", "null"] }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "tier",
        "publisher",
        "title",
        "url",
        "published_at",
        "retrieved_at",
        "available_as_of",
        "locator"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^S[0-9]+$" },
        "tier": { "type": "integer", "minimum": 1, "maximum": 5 },
        "publisher": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "published_at": { "type": "string", "format": "date-time" },
        "retrieved_at": { "type": "string", "format": "date-time" },
        "available_as_of": { "type": "string", "format": "date-time" },
        "period": { "type": ["string", "null"] },
        "locator": { "type": "string", "minLength": 1 },
        "content_hash": { "type": ["string", "null"] }
      }
    }
  }
}

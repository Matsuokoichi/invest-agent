{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.fulcrum.local/evaluation-suite-v1.json",
  "title": "Evaluation Suite V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["suite_id", "protocol_version", "cases"],
  "properties": {
    "suite_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]+$"
    },
    "protocol_version": { "const": "1.0.0" },
    "description": { "type": "string" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}

